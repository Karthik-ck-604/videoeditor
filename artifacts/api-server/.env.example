# Required recipient
RECRUITER_EMAIL=recruiter@evocaa.com

# Resend SDK used for recruiter notifications (no SMTP required)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender address. Use "onboarding@resend.dev" for testing — it only delivers to
# the developer's own verified email until a real domain is verified on Resend.
# For production, verify a custom domain and use an address on that domain.
FROM_EMAIL=onboarding@resend.dev